{
  "expo": {
    "name": "Circle",
    "slug": "mycircle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mycircle",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mycircle.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050508",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Circle",
      "shortName": "Circle",
      "description": "Warm intros through people you already trust — not cold DMs.",
      "themeColor": "#050508",
      "backgroundColor": "#050508"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#050508"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "MyCircle uses your contacts to help you find people already in your circle."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
